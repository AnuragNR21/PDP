# Copy to backend/.env and adjust. Every key is read with the PDP_ prefix (see app/config.py).

PDP_ENVIRONMENT=development
PDP_LOG_LEVEL=INFO
PDP_DATABASE_URL=postgresql://postgres:password@localhost:5433/pdp
PDP_LOCALHOST_IP_WHITELIST=["127.0.0.1"]

# ── Authentication (PDP-251) ──────────────────────────────────────────────
# HS256 signing key for access tokens. Generate one per deployment:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
PDP_JWT_SECRET=change-me
# Access token lifetime in hours.
PDP_JWT_HOURS=8
# Seeded on startup when no user holds the Admin role. First login forces a password change.
PDP_BOOTSTRAP_SUPERADMIN_EMAIL=admin@solutionadvisor.com.au
PDP_BOOTSTRAP_SUPERADMIN_PASSWORD=OYmjnBUtEsOS
# Public frontend address used in invitation and password reset links.
PDP_FRONTEND_BASE_URL=http://localhost:5173
PDP_INVITATION_DAYS=7
PDP_PASSWORD_RESET_HOURS=2

# ── Build information (Admin > Application Information); set by the pipeline ─
PDP_BUILD_ID=
PDP_BUILD_COMMIT=
PDP_BUILD_TIME=
