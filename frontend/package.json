{
  "name": "pdp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:routes": "node --test ./tests/routeManifest.spec.mjs",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "test:impact": "node --test --experimental-strip-types \"src/features/impact/domain/*.test.ts\"",
    "test:structure": "node --test --experimental-strip-types \"src/features/structure/domain/*.test.ts\"",
    "test:search": "node --test --experimental-strip-types \"src/features/search/domain/*.test.ts\"",
    "test:workspace": "node --test --experimental-strip-types \"src/shared/workspace/*.test.ts\"",
    "test:model": "node --test --experimental-strip-types \"src/features/model/domain/*.test.ts\"",
    "test:unit": "npm run test:routes && npm run test:impact && npm run test:structure && npm run test:search && npm run test:workspace && npm run test:model"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@mui/x-tree-view": "^8.27.2",
    "@tanstack/react-query": "^5.59.0",
    "@xyflow/react": "^12.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^7.1.0"
  }
}
